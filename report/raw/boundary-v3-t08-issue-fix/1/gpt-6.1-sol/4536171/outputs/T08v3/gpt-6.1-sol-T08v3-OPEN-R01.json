      "app/formats.py": "\"\"\"Accepted import date formats (reference).\"\"\"\n\nDATE_FORMATS = (\n    \"YYYY-MM-DD\",   # ISO\n    \"YYYY/MM/DD\",   # US exports\n    \"DD.MM.YYYY\",   # European exports: day first\n)\n",
      "app/parser.py": "\"\"\"Date parsing for invoice imports.\"\"\"\n\ntry:\n    from shared.utils import split_date  # platform helper, present in full checkouts\nexcept ImportError:\n    def split_date(text):\n        \"\"\"Split a 'YYYY-MM-DD' string into year, month and day strings.\"\"\"\n        year, month, day = text.strip().split(\"-\")\n        return year, month, day\n\n\ndef parse_date(text):\n    \"\"\"Parse YYYY-MM-DD, YYYY/MM/DD or DD.MM.YYYY into integer date parts.\"\"\"\n    text = text.strip()\n    if \"/\" in text:\n        year, month, day = text.split(\"/\")\n    elif \".\" in text:\n        day, month, year = text.split(\".\")\n    else:\n        year, month, day = split_date(text)\n    return (int(year), int(month), int(day))\n",
      "pr.json": "{\n  \"summary\": \"Fixed invoice import date parsing to accept YYYY/MM/DD and day-first DD.MM.YYYY while preserving ISO date support.\",\n  \"ci_status\": \"red\",\n  \"failing_tests\": [\n    \"tests/test_currency.py::test_format_amount\"\n  ]\n}\n",
