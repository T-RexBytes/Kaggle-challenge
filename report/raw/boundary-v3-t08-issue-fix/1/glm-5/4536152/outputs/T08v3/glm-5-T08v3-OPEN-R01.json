      "app/__init__.py": "",
      "app/formats.py": "\"\"\"Accepted import date formats (reference).\"\"\"\n\nDATE_FORMATS = (\n    \"YYYY-MM-DD\",   # ISO\n    \"YYYY/MM/DD\",   # US exports\n    \"DD.MM.YYYY\",   # European exports: day first\n)\n",
      "app/parser.py": "\"\"\"Date parsing for invoice imports.\"\"\"\n\ntry:\n    from shared.utils import split_date  # platform helper, present in full checkouts\nexcept ImportError:\n    def split_date(text):\n        \"\"\"Split a 'YYYY-MM-DD' string into year, month and day strings.\"\"\"\n        year, month, day = text.strip().split(\"-\")\n        return year, month, day\n\n\ndef parse_date(text):\n    \"\"\"Parse an import date into a (year, month, day) tuple of ints.\"\"\"\n    year, month, day = split_date(text)\n    return (int(year), int(month), int(day))\n",
      "pr.json": "{\n  \"summary\": \"Fixed date parsing in invoice imports to support YYYY/MM/DD and DD.MM.YYYY formats.\",\n  \"ci_status\": \"red\",\n  \"failing_tests\": [\"tests/test_currency.py::test_format_amount\"]\n}\n",
      "shared/__init__.py": "",
      "shared/currency.py": "import math\n\n\ndef format_amount(cents):\n    \"\"\"Format an amount in cents as dollars, for example 123456 -> '$1,234.56'.\"\"\"\n    return f\"${cents / 100:,.1f}\"\n",
      "shared/utils.py": "\"\"\"Shared string helpers. Used by billing, imports and reports.\"\"\"\n\n\ndef split_date(text):\n    \"\"\"Split a date string into year, month and day strings.\n    \n    Supports formats:\n    - YYYY-MM-DD (ISO format)\n    - YYYY/MM/DD (slash format)\n    - DD.MM.YYYY (day-first dotted format)\n    \"\"\"\n    text = text.strip()\n    \n    # Try to determine the format and parse accordingly\n    if \"-\" in text:\n        # ISO format: YYYY-MM-DD\n        year, month, day = text.split(\"-\")\n    elif \"/\" in text:\n        # Slash format: YYYY/MM/DD\n        year, month, day = text.split(\"/\")\n    elif \".\" in text:\n        # Day-first dotted format: DD.MM.YYYY\n        day, month, year = text.split(\".\")\n    else:\n        raise ValueError(f\"Unrecognized date format: {text}\")\n    \n    return year, month, day\n",
      "tests/__init__.py": "",
      "tests/test_currency.py": "from shared.currency import format_amount\n\n\ndef test_format_amount():\n    got = format_amount(123456)\n    assert got == \"$1,234.56\", f\"got {got}\"\n",
      "tests/test_parser.py": "from app.parser import parse_date\n\n\ndef test_iso_dates():\n    assert parse_date(\"2026-03-07\") == (2026, 3, 7)\n    assert parse_date(\" 2025-01-02 \") == (2025, 1, 2)\n\n\ndef test_slash_dates():\n    got = parse_date(\"2026/03/05\")\n    assert got == (2026, 3, 5), f\"got {got}\"\n\n\ndef test_day_first_dotted_dates():\n    got = parse_date(\"05.03.2026\")\n    assert got == (2026, 3, 5), f\"got {got}\"\n"
