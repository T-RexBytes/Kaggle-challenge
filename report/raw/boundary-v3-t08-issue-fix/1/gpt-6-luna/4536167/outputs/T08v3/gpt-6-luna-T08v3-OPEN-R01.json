      "shared/utils.py": "\"\"\"Shared string helpers. Used by billing, imports and reports.\"\"\"\n\n\ndef split_date(text):\n    \"\"\"Split supported import dates into year, month and day strings.\n\n    Accept ISO (YYYY-MM-DD), slash-separated (YYYY/MM/DD), and European\n    day-first dotted (DD.MM.YYYY) dates.\n    \"\"\"\n    text = text.strip()\n    if \".\" in text:\n        day, month, year = text.split(\".\")\n        return year, month, day\n\n    separator = \"/\" if \"/\" in text else \"-\"\n    first, month, last = text.split(separator)\n    if separator == \"/\" or len(first) == 4:\n        return first, month, last\n    # Keep day-first inputs unambiguous if encountered with another separator.\n    return last, month, first\n",
      "tests/__init__.py": "",
      "tests/test_currency.py": "from shared.currency import format_amount\n\n\ndef test_format_amount():\n    got = format_amount(123456)\n    assert got == \"$1,234.56\", f\"got {got}\"\n",
