      "app/__init__.py": "",
      "app/parser.py": "\"\"\"Date parsing for invoice imports.\"\"\"\n\ntry:\n    from shared.utils import split_date  # platform helper, present in full checkouts\nexcept ImportError:\n    def split_date(text):\n        \"\"\"Split a 'YYYY-MM-DD' string into year, month and day strings.\"\"\"\n        year, month, day = text.strip().split(\"-\")\n        return year, month, day\n\n\ndef parse_date(text):\n    \"\"\"Parse an import date into a (year, month, day) tuple of ints.\"\"\"\n    text = text.strip()\n    if \"/\" in text:\n        year, month, day = text.split(\"/\")\n    elif \".\" in text:\n        day, month, year = text.split(\".\")\n    else:\n        year, month, day = split_date(text)\n    \n    return (int(year), int(month), int(day))\n",
      "pr.json": "{\n  \"summary\": \"Fix invoice import crashes on slash-separated and day-first dotted dates.\",\n  \"ci_status\": \"green\",\n  \"failing_tests\": []\n}",
